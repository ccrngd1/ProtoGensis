{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@guards/*": ["./guards/*"]
    }
  },
  "include": ["correct-api.ts", "guards/**/*"],
  "exclude": ["bad-api.ts"]
}
